# Copy this file to .env and fill in your own values. Never commit .env.
MONGO_URI=mongodb://127.0.0.1:27017/tiket-help
JWT_SECRET=change_me_to_a_long_random_string
PORT=3000
# Optional: allowed frontend origins, comma separated (empty = allow all)
CORS_ORIGIN=
# Optional: timezone for the stats timeline (default UTC)
STATS_TIMEZONE=Africa/Tunis
# Optional: set to 1 only when deployed behind a proxy (Render, Railway, Nginx...)
TRUST_PROXY=
# Optional: folder for uploaded files (default uploads/tickets)
UPLOAD_DIR=
